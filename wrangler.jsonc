// Site ClippitStudio : Worker SÉPARÉ du quiz.
// Ne jamais mettre "quiz-hardcore" comme nom ici : un deploy remplacerait le quiz.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clippitstudio",
  // Compte Cloudflare de wal (celui du quiz) : un membre invité y a aussi son
  // propre compte, et wrangler ne doit pas lui demander lequel choisir.
  "account_id": "aeeb4be461ed38195fefd2e782f23684",
  "compatibility_date": "2026-11-01",

  // Fichiers statiques uniquement, pas de "main" : aucun script exécuté,
  // donc rien ne s'impute sur les 100 000 requêtes Workers/jour partagées avec le quiz.
  "assets": { "directory": "public" },

  // Servi aussi sur https://clippitstudio.quiz-hardcore.workers.dev
  "workers_dev": true,

  // Domaines personnalisés : le déploiement crée lui-même les enregistrements DNS.
  // Jamais de route générique *.clippitstudio.cc/* : quiz.clippitstudio.cc est réservé au quiz.
  "routes": [
    { "pattern": "clippitstudio.cc", "custom_domain": true },
    { "pattern": "www.clippitstudio.cc", "custom_domain": true }
  ]
}
